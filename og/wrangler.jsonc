{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "bellhop-og",
  "main": "index.ts",
  "account_id": "15d29c8639fd3733b1b5486a2acfd968",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "bellhop-media" }],
  "rules": [
    { "type": "Data", "globs": ["**/*.ttf"], "fallthrough": true },
    { "type": "Text", "globs": ["**/*.svg"], "fallthrough": true }
  ]
}
