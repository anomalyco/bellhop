{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bellhop",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/*", "!/assets/*", "!/fonts/*", "!/favicon.svg", "!/apple-touch-icon.png"]
  },
  "d1_databases": [{ "binding": "DB", "database_name": "bellhop", "database_id": "local", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "bellhop-media" }],
  "services": [{ "binding": "OG", "service": "bellhop-og" }],
  "ratelimits": [
    { "name": "RL_V1_IP", "namespace_id": "741307", "simple": { "limit": 600, "period": 60 } },
    { "name": "RL_V1_READ", "namespace_id": "741308", "simple": { "limit": 300, "period": 60 } },
    { "name": "RL_V1_SECRET", "namespace_id": "741309", "simple": { "limit": 6000, "period": 60 } },
    { "name": "RL_UPLOAD", "namespace_id": "741301", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_HUMAN", "namespace_id": "741302", "simple": { "limit": 6, "period": 60 } },
    { "name": "RL_WRITE", "namespace_id": "741303", "simple": { "limit": 15, "period": 60 } },
    { "name": "RL_IP", "namespace_id": "741304", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_TEAM", "namespace_id": "741305", "simple": { "limit": 60, "period": 60 } },
    { "name": "RL_AGENT", "namespace_id": "741306", "simple": { "limit": 120, "period": 60 } }
  ],
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "queues": {
    "producers": [{ "binding": "WEBHOOKS", "queue": "bellhop-webhooks" }, {"binding":"MAIL","queue":"bellhop-mail"}],
    "consumers": [{ "queue": "bellhop-webhooks", "max_retries": 6, "max_batch_size": 10, "max_batch_timeout": 1 }, {"queue":"bellhop-mail","max_retries":6,"max_batch_size":5,"max_batch_timeout":1}]
  },
  "triggers":{"crons":["* * * * *"]},
  "vars": {
    "OPENSEND_API":"https://opensend.anoma.ly",
    "RATE_LIMIT_TEST_BYPASS": "0",
    // Cloudflare's always-pass test key; replace per environment.
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    // Empty: apps live under /<slug>. Production serves each app on <slug>.APP_DOMAIN.
    "APP_DOMAIN": ""
  },
  "env": {
    // Build with CLOUDFLARE_ENV=production; deploy with the work account (wwrangler).
    // Secrets: TURNSTILE_SECRET_KEY, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, COOKIE_SECRET. Never DEV_LOGIN.
    "production": {
      "name": "bellhop",
      "account_id": "15d29c8639fd3733b1b5486a2acfd968",
      // The apex is a custom domain; app subdomains reach the Worker through a wildcard route
      // (needs a proxied wildcard DNS record; Universal SSL covers *.blhp.app).
      "routes": [
        { "pattern": "blhp.app", "custom_domain": true },
        { "pattern": "*.blhp.app/*", "zone_name": "blhp.app" }
      ],
      "workers_dev": false,
      "preview_urls": false,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "bellhop",
          "database_id": "d58d04f7-4a16-462e-8524-97ca755c1cf2",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "bellhop-media" }],
      "services": [{ "binding": "OG", "service": "bellhop-og" }],
      "ratelimits": [
        { "name": "RL_V1_IP", "namespace_id": "741407", "simple": { "limit": 600, "period": 60 } },
        { "name": "RL_V1_READ", "namespace_id": "741408", "simple": { "limit": 300, "period": 60 } },
        { "name": "RL_V1_SECRET", "namespace_id": "741409", "simple": { "limit": 6000, "period": 60 } },
        { "name": "RL_UPLOAD", "namespace_id": "741401", "simple": { "limit": 10, "period": 60 } },
        { "name": "RL_HUMAN", "namespace_id": "741402", "simple": { "limit": 6, "period": 60 } },
        { "name": "RL_WRITE", "namespace_id": "741403", "simple": { "limit": 15, "period": 60 } },
        { "name": "RL_IP", "namespace_id": "741404", "simple": { "limit": 30, "period": 60 } },
        { "name": "RL_TEAM", "namespace_id": "741405", "simple": { "limit": 60, "period": 60 } },
        { "name": "RL_AGENT", "namespace_id": "741406", "simple": { "limit": 120, "period": 60 } }
      ],
      "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }] },
      "queues": {
        "producers": [{ "binding": "WEBHOOKS", "queue": "bellhop-webhooks" }, {"binding":"MAIL","queue":"bellhop-mail"}],
        "consumers": [{ "queue": "bellhop-webhooks", "max_retries": 6, "max_batch_size": 10, "max_batch_timeout": 1 }, {"queue":"bellhop-mail","max_retries":6,"max_batch_size":5,"max_batch_timeout":1}]
      },
      "triggers":{"crons":["* * * * *"]},
      "vars": { "TURNSTILE_SITE_KEY": "0x4AAAAAAFyiw9jNJFZ6Fa22", "APP_DOMAIN": "blhp.app", "RATE_LIMIT_TEST_BYPASS": "0","OPENSEND_API":"https://opensend.anoma.ly", "MAIL_DELIVERY": "live" },
      "observability": { "enabled": true, "redact_query_string": true }
    }
  }
}
