{
  "name": "bellhop",
  "private": true,
  "type": "module",
  "scripts": {
    "fonts": "bun scripts/fonts.ts",
    "dev": "bun scripts/fonts.ts && vite --host 127.0.0.1 --port 5287 --strictPort",
    "build": "bun scripts/fonts.ts && vite build",
    "typecheck": "tsc -b",
    "db:migrate": "wrangler d1 migrations apply bellhop --local"
  },
  "dependencies": {
    "hono": "^4.13.16",
    "markdown-it": "^15.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "wouter": "^3.13.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@cloudflare/workers-types": "^5.20261103.1",
    "@types/markdown-it": "^14.1.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "wrangler": "^4.157.0"
  }
}
